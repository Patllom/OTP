        jQuery(document).ready(function () {
            /*   updatevisitor อยู่หหน้า INDEX */
            jQuery.ajax({
                type: "get",
                url: "https://www.tpr-10.com/home/getvisitor/tdc-otp",
                data: {},
                dataType: "json",
                success: function (response) {
                    console.log(response);
                    jQuery("#lbvisitor1").html(response[0].v_num.toLocaleString() + " ");
                    jQuery("#lbvisitor2").html(response[1].v_num.toLocaleString() + " ");
                    jQuery("#lbvisitor3").html(response[2].v_num.toLocaleString() + " ");
                    jQuery("#lbvisitor4").html(response[3].v_num.toLocaleString() + " ");
                },
                error: function (xhr, status, error) {
                    console.log("error");
                    console.error("เกิดข้อผิดพลาด:", error);
                }
            });
        });


    </script>
