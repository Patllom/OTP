@{
    ViewBag.Title = "Home Page";
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
}

@section Scripts {

}

@section Styles {
    <style>

        h2 {
            font-size: 46px;
        }

        .item-title {
            margin-top: 10px;
        }

        body {
            font-family: "Noto Sans Thai", Tahoma;
        }
    </style>

}


<section class="">
    <div class="slider-items-products container">
        <div class="new_title">
            <h2 class="">    ความเป็นมาของโครงการ   </h2>
        </div>

        <div class="entry-content">
            <p class="" style="font-size: 20px;color: darkblue;text-indent: 2.5em;line-height:30px">
                ยุทธศาสตร์ชาติ พ.ศ. 2561 - 2580 ยุทธศาสตร์ที่ 2 ยุทธศาสตร์ชาติด้านการสร้างความสามารถ
                ในการแข่งขัน ได้กำหนดเป้าหมายการพัฒนาที่มุ่งเน้นการยกระดับศักยภาพของประเทศในหลากหลายมิติ
                เพื่อเพิ่มขีดความสามารถในการแข่งขันของประเทศ โดยมุ่งสนับสนุนการยกระดับความสามารถในการแข่งขันของการผลิตและบริการ
                สร้างคุณภาพชีวิตที่ดีของทุกคนในสังคมและช่วยลดความเหลื่อมล้ำทางสังคมและพัฒนาระบบขนส่ง เพื่อให้เกิดการเชื่อมโยงเป็นโครงข่ายที่สมบูรณ์และลดต้นทุนทางเศรษฐกิจและสังคม
                ซึ่งการสร้างโอกาสเข้าถึงข้อมูลให้ผู้ประกอบการสามารถเข้าถึงข้อมูลข่าวสารที่จำเป็นและเป็นข้อมูลที่ทันสมัย
                เพื่อการวางแผนธุรกิจสามารถเข้าถึงและใช้ประโยชน์จากเทคโนโลยีฐานข้อมูลขนาดใหญ่
            </p>
            <p class="" style="font-size: 20px;color: darkblue;text-indent: 2.5em;line-height:30px">
                การพัฒนาระบบฐานข้อมูลและสร้างระบบเชื่อมโยงข้อมูลระหว่างหน่วยงานภาครัฐให้มีมาตรฐานเดียวกัน รวมถึงฐานข้อมูลความรู้วิจัยและนวัตกรรมโดยเป็นข้อมูลที่ทันสมัย
                บูรณาการและต่อเนื่อง เพื่อประโยชน์ในการสืบค้นต่อยอดในทุก ๆ ด้าน ซึ่งสามารถเข้าถึงและใช้ประโยชน์ร่วมกันในการวางแผนธุรกิจในอนาคต
                เพื่อลดต้นทุนของทั้งภาครัฐและเอกชน
            </p>
            <p class="" style="font-size: 20px;color: darkblue;text-indent: 2.5em;line-height:30px">
                แผนแม่บทภายใต้ยุทธศาสตร์ชาติ (พ.ศ. 2566 - 2580) (ฉบับแก้ไขเพิ่มเติม) ประเด็นโครงสร้างพื้นฐานระบบโลจิสติกส์และดิจิทัล เป็นส่วนสำคัญของการสร้างขีดความสามารถในการแข่งขันของประเทศในแผนแม่บท
                ได้กำหนดแนวทางการพัฒนาและบูรณาการการเดินทางและขนส่งทุกรูปแบบและฐานข้อมูล เพื่อนำไปสู่การควบคุมสั่งการและบริหารจัดการจราจรอัจฉริยะทั้งในระดับพื้นที่และระดับประเทศ พร้อมทั้งพัฒนาระบบเทคโนโลยีดิจิทัลและนวัตกรรมด้านคมนาคม เพื่อให้ประชาชนผู้ใช้บริการสามารถใช้เป็นข้อมูลในการวางแผนค่าใช้จ่ายและระยะเวลาที่ใช้การเดินทางและขนส่งสินค้าได้อย่างมีประสิทธิภาพ

            </p>
            <p class="" style="font-size: 20px;color: darkblue;text-indent: 2.5em;line-height:30px">
                แผนพัฒนาเศรษฐกิจและสังคมแห่งชาติ ฉบับที่ 13 พ.ศ. 2566 - 2570 ได้กำหนดบริบทการพัฒนาประเทศในมิติด้านการบริหารจัดการภาครัฐ
                ซึ่งกำหนดให้ภาครัฐต้องยกระดับคุณภาพและประสิทธิภาพในการบริหารจัดการภาครัฐให้สามารถตอบสนองต่อความต้องการของประชาชนได้อย่างเป็นรูปธรรมและทันต่อสถานการณ์โดยภาครัฐต้องเป็นรัฐบาลดิจิทัลที่ใช้ข้อมูลในการบริหารจัดการเพื่อการพัฒนาประเทศ
                มีการปรับเปลี่ยนข้อมูลภาครัฐทั้งหมดให้เป็นดิจิทัล โดยจัดทำข้อมูลสำหรับการบริหารจัดการทรัพยากรของประเทศทั้งในด้านงบประมาณทรัพยากรบุคคล
                และข้อมูลอื่นของหน่วยงานของรัฐทั้งหมดอย่างบูรณาการให้เป็นดิจิทัลที่มีมาตรฐาน ถูกต้องปลอดภัย พร้อมใช้งาน มีการจัดเก็บที่ไม่ซ้ำซ้อน ไม่เป็นภาระกับผู้ให้ข้อมูล
                มีการเชื่อมโยงข้อมูลระหว่างหน่วยงานของรัฐและเอกชน เพื่อให้เกิดการวิเคราะห์และประมวลผลข้อมูลประกอบการตัดสินใจเชิงนโยบายและการบริหารจัดการภาครัฐให้สอดคล้องกับบริบทการพัฒนาได้อย่างเป็นปัจจุบัน
                พร้อมทั้งเปิดเผยข้อมูลที่จำเป็นต่อสาธารณะในการใช้ประโยชน์ร่วมกันเพื่อพัฒนาประเทศ
            </p>
            <p class="" style="font-size: 20px;color: darkblue;text-indent: 2.5em;line-height:30px">
                สำนักงานนโยบายและแผนการขนส่งและจราจร (สนข.) กระทรวงคมนาคม ในฐานะหน่วยงานหลักในการจัดทำนโยบายและแผนด้านการคมนาคม 
                รวมทั้งเสนอแนะนโยบายและแผนด้านการขนส่งและจราจรของประเทศมีบทบาทสำคัญในการจัดทำข้อมูลและสารสนเทศด้านการขนส่งและจราจรของประเทศ 
                เพื่อให้มีข้อมูลสำหรับการจัดทำเสนอแนะนโยบายและแผน ไม่ว่าจะเป็นแผนหลัก แผนแม่บท รวมทั้งยุทธศาสตร์ การพัฒนาระบบการขนส่งและจราจร 
                ความปลอดภัยและสิ่งแวดล้อมในระบบคมนาคมของประเทศ จึงจำเป็นต้องดำเนินการศึกษาและพัฒนาศูนย์ข้อมูลคมนาคมของประเทศไทย (Transport Data Center) 
                เพื่อให้เกิดการบูรณาการข้อมูลร่วมกันระหว่างหน่วยงานทั้งภายใน สนข. หน่วยงานภายในกระทรวงคมนาคม และหน่วยงานภายนอกอื่น ๆ 
                ที่เกี่ยวข้องเพื่อจัดทำระบบฐานข้อมูลเชิงยุทธศาสตร์ในรูปแบบดิจิทัลที่มีความถูกต้อง พร้อมใช้งานมีมาตรฐาน มีความปลอดภัยทางไซเบอร์ 
                รวมทั้งมีการเปิดเผยข้อมูลที่จำเป็นต่อสาธารณะเพื่อให้เกิดการนำข้อมูลด้านคมนาคมไปใช้ประโยชน์ร่วมกัน และช่วยเพิ่มศักยภาพการวิเคราะห์ข้อมูลในเชิงลึก 
                พร้อมประมวลผลข้อมูลด้านการขนส่งและจราจรประกอบการตัดสินใจเชิงนโยบายและการบริหารจัดการภาครัฐที่สามารถติดตามความก้าวหน้าและประเมินผลสัมฤทธิ์ในภาพรวม 
                เพื่อขับเคลื่อนการพัฒนาประเทศได้อย่างมีประสิทธิภาพต่อไป
            </p>
        </div>
    </div>
</section>

