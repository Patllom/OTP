@{
    var skillsDevelopmentGalleries = new[]
    {
        new { Number = 2, PhotoCount = 13 },
        new { Number = 3, PhotoCount = 14 },
        new { Number = 4, PhotoCount = 15 },
        new { Number = 5, PhotoCount = 13 }
    };
}

@foreach (var gallery in skillsDevelopmentGalleries)
{
    var heading = $"การพัฒนาทักษะความรู้ ครั้งที่ {gallery.Number}";

    <div class="row" style="margin-top:30px;margin-bottom:30px;">
        <div class="col-md-12">
            <h4 class="text-center">@heading</h4>
        </div>

        @for (var photoNumber = 1; photoNumber <= gallery.PhotoCount; photoNumber++)
        {
            var photoPath = $"/asset/images/knowledgetech/sub{gallery.Number}/{photoNumber}.jpg";
            var altText = $"{heading} ภาพที่ {photoNumber}";

            <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12" style="padding: 3px;">
                <a href="@photoPath" aria-label="@($"เปิด{altText}")"> <img class="card-img-top img-rounded" src="@photoPath" alt="@altText" loading="lazy" style="width:100%;height:150px;object-fit:cover;object-position:center;"></a>
            </div>
        }
    </div>
}

</div>
