@{
    ViewBag.Title = "Home Page";
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
}

@section Scripts {

    <script>

        jQuery(document).ready(function () {
            jQuery.ajax({
                url: "https://www.tpr-10.com/home/updatevisitor/tdc-otp",
                method: "GET",
                success: function (response) {
                    console.log("เรียกสำเร็จแล้วครับ");
                },
                error: function (xhr, status, error) {
                    console.error("เกิดข้อผิดพลาด:", error);
                }
            });
        });

    </script>


}

@section Styles {
    <style>

        h2 {
            font-size: 46px;
        }

        .item-title {
            margin-top: 10px;
        }

        body {
            font-family: "Noto Sans Thai", Tahoma;
        }
    </style>

}


